# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# First administrator (created by `manage.py seed` only if none exists)
ADMIN_MOBILE=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Alerts — leave blank to keep a channel off
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SiteOS <no-reply@tridashaimperial.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=siteos_alert
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
